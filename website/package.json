{
  "name": "next-motion-ai-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "npm run build && node --test tests/*.test.mjs",
    "deploy": "npm run build && gh-pages -d dist -b gh-pages --nojekyll -r git@github.com:nextmotionai/next-motion-ai-pages.git"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
