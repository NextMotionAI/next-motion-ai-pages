---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
const pageTitle = title.startsWith('Next Motion AI |') ? title : `${title} | Next Motion AI`;
const canonicalPath = Astro.url.pathname === '/index.html'
  ? '/'
  : Astro.url.pathname.replace(/\.html$/, '') || '/';
const canonical = new URL(canonicalPath, Astro.site).href;
const socialImage = new URL('/img/logo_512.png', Astro.site).href;
const year = new Date().getFullYear();
const researchActive = canonicalPath === '/research' || canonicalPath.startsWith('/research/') || canonicalPath.startsWith('/journal/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="keywords" content="Reinforcement Learning, Computational Biology, Biological Discovery, AI for Science" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/img/logo_96.png" />
    <link rel="alternate" type="application/rss+xml" title="Next Motion AI Research Notes RSS" href="/journal/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title="Next Motion AI Research Notes Atom" href="/journal/atom.xml" />
    <title>{pageTitle}</title>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YLHJEZJCWG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-YLHJEZJCWG', { anonymize_ip: true });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="Next Motion AI home">
          <img src="/img/logo-mark.svg" alt="" width="34" height="34" />
          <span>Next Motion <span class="brand-ai">AI</span></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/platform" aria-current={Astro.url.pathname.replace(/\.html$/, '') === '/platform' ? 'page' : undefined}>Platform</a>
          <details class="nav-dropdown" data-active={researchActive ? 'true' : undefined}>
            <summary>Research<span class="nav-dropdown-chevron" aria-hidden="true"></span></summary>
            <div class="nav-dropdown-menu">
              <a href="/research" aria-current={canonicalPath === '/research' ? 'page' : undefined}>Overview</a>
              <a href="/research/peptide-mhc-binding" aria-current={canonicalPath === '/research/peptide-mhc-binding' ? 'page' : undefined}>Peptide–MHC binding</a>
            </div>
          </details>
          <a class="nav-contact" href="mailto:contact@nextmotionai.com">Contact</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <p class="eyebrow eyebrow-light">NEXT MOTION AI</p>
          <p class="footer-statement">Building a reinforcement learning platform for biology.</p>
        </div>
        <a class="footer-email" href="mailto:contact@nextmotionai.com">contact@nextmotionai.com</a>
      </div>
      <div class="container footer-bottom">
        <p>© {year} Next Motion, Inc.</p>
        <nav aria-label="Footer navigation">
          <a href="/platform">Platform</a>
          <a href="/research">Research</a>
        </nav>
      </div>
    </footer>
    <script>
      const researchMenu = document.querySelector<HTMLDetailsElement>('.nav-dropdown');
      if (researchMenu) {
        document.addEventListener('pointerdown', (event) => {
          if (!researchMenu.contains(event.target as Node)) researchMenu.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && researchMenu.open) {
            researchMenu.open = false;
            researchMenu.querySelector('summary')?.focus();
          }
        });
      }
    </script>
  </body>
</html>
