---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../../lib/posts';

const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Journal tags" description="Browse Next Motion AI journal topics.">
  <main id="main-content" class="container article-shell">
    <a class="back-link" href="/blog">← Journal</a>
    <h1 class="page-heading">Tags</h1>
    {tags.length ? <p class="tag-list">{tags.map((tag) => <a class="tag" href={`/blog/tags/${tag}`}>{tag}</a>)}</p> : <p>No research notes published yet.</p>}
  </main>
</BaseLayout>
