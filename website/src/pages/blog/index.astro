---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = (await getPublishedPosts()).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [featured, ...morePosts] = posts;
---

<BaseLayout title="Journal" description="Research notes on machine learning, biological discovery, and what we learn along the way.">
  <main id="main-content">
    <section class="journal-landing">
      <div class="container journal-landing-head">
        <p class="eyebrow"><span class="eyebrow-line"></span> NEXT MOTION AI / JOURNAL</p>
        <h1>Notes from the <em>frontier of discovery.</em></h1>
        <p>Questions, methods, and lessons from our work at the intersection of machine learning and biology.</p>
      </div>
    </section>

    {featured && (
      <section class="journal-feature-section" aria-labelledby="featured-heading">
        <div class="container">
          <div class="journal-section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> LATEST NOTE</p>
            <a class="text-link" href="/blog/archive">View archive <span aria-hidden="true">↗</span></a>
          </div>
          <article class="journal-feature">
            <div class="journal-feature-copy">
              <p class="journal-feature-meta"><time datetime={featured.data.date.toISOString().slice(0, 10)}>{featured.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time><span aria-hidden="true">·</span>{featured.data.author}</p>
              <h2 id="featured-heading"><a href={`/blog/${featured.id}`}>{featured.data.title}</a></h2>
              <p>{featured.data.description}</p>
              <a class="text-link" href={`/blog/${featured.id}`}>Read the note <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        </div>
      </section>
    )}

    {morePosts.length > 0 && (
      <section class="journal-more-section">
        <div class="container">
          <p class="eyebrow"><span class="eyebrow-line"></span> MORE NOTES</p>
          <PostList posts={morePosts} />
        </div>
      </section>
    )}

    <section class="journal-about">
      <div class="container journal-about-grid">
        <p class="eyebrow"><span class="eyebrow-line"></span> ABOUT THE JOURNAL</p>
        <p>We’ll share the questions we ask, the choices we make, and what the evidence lets us say as the work develops.</p>
        <a class="text-link" href="mailto:contact@nextmotionai.com">Join the conversation <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
