---
import BaseLayout from '../layouts/BaseLayout.astro';
import DiscoveryField from '../components/DiscoveryField.astro';
import { getPublishedPosts } from '../lib/posts';

const latestProjectPost = (await getPublishedPosts())
  .filter((post) => post.data.project === 'peptide-mhc-binding')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
---

<BaseLayout
  title="Next Motion AI | Reinforcement Learning for Computational Biology"
  description="Next Motion AI is building a reinforcement learning platform for biology, beginning with a peptide–MHC binding project."
>
  <main id="main-content">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <h1>Building a reinforcement learning platform for biology.</h1>
          <p class="hero-description">We’re developing a way to use feedback to make better choices across large biological search spaces. Peptide–MHC binding is the first project we’ve initiated to test that approach.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="/platform">Explore the platform <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <DiscoveryField />
      </div>
    </section>

    <section class="home-project section-space" aria-labelledby="home-project-heading">
      <div class="container home-project-grid">
        <div class="home-project-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> FIRST PROJECT</p>
          <h2 id="home-project-heading" class="display-heading">Starting with <em>peptide–MHC binding.</em></h2>
          <p>Our first project asks whether feedback can improve which peptide candidates we choose to examine next. It gives us a defined setting to develop the platform and compare adaptive choices with a strong fixed ranking.</p>
          <a class="text-link" href="/research/peptide-mhc-binding">Explore the project <span aria-hidden="true">↗</span></a>
        </div>
        {latestProjectPost && <article class="home-project-note">
          <p class="home-project-note-meta">LATEST NOTE <span aria-hidden="true">·</span> <time datetime={latestProjectPost.data.date.toISOString().slice(0, 10)}>{latestProjectPost.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time></p>
          <h3><a href={`/journal/${latestProjectPost.id}`}>{latestProjectPost.data.title}</a></h3>
          <p>{latestProjectPost.data.description}</p>
          <a class="text-link" href={`/journal/${latestProjectPost.id}`}>Read the note <span aria-hidden="true">↗</span></a>
        </article>}
      </div>
    </section>

    <section class="approach-section section-space" aria-labelledby="approach-heading">
      <div class="container">
        <div class="section-heading-row">
          <div>
            <p class="eyebrow"><span class="eyebrow-line"></span> THE PLATFORM APPROACH</p>
            <h2 id="approach-heading" class="display-heading">From feedback to <em>the next choice.</em></h2>
          </div>
          <p>We compare adaptive search with simpler methods to test whether feedback changes which candidates we prioritize.</p>
        </div>
        <div class="lens-grid">
          <article class="lens-card">
            <span class="lens-number">01</span>
            <div class="lens-art lens-art-diagram" aria-hidden="true">
              <svg viewBox="0 0 280 112" focusable="false">
                <rect x="7" y="9" width="266" height="94" rx="12" fill="#e8f2eb" stroke="#a8c5be" />
                <circle cx="36" cy="36" r="5" fill="#a8cfc2" />
                <circle cx="58" cy="72" r="4" fill="#b9d8cc" />
                <circle cx="225" cy="33" r="4" fill="#b9d8cc" />
                <circle cx="247" cy="72" r="6" fill="#a8cfc2" />
                <path d="M40 72h-16M231 76h-13M229 51h26" stroke="#9dbfb4" stroke-width="2" stroke-linecap="round" />
                <rect x="78" y="22" width="124" height="68" rx="9" fill="#f8fbf5" stroke="#54869a" stroke-width="1.5" />
                <path d="M87 37v-7h8M193 37v-7h-8M87 75v7h8M193 75v7h-8" fill="none" stroke="#386f9c" stroke-width="2" stroke-linecap="round" />
                <circle cx="125" cy="56" r="18" fill="#deebe6" />
                <path d="M120 51a6 6 0 1 1 10 5c-3 2-5 3-5 6" fill="none" stroke="#386f9c" stroke-width="2.8" stroke-linecap="round" />
                <circle cx="125" cy="69" r="1.7" fill="#386f9c" />
                <path d="M155 48h27M155 57h21M155 66h25" stroke="#a9c6be" stroke-width="3" stroke-linecap="round" />
              </svg>
            </div>
            <h3>Frame the question</h3>
            <p>Start with a biological question and define what the available evidence can and cannot tell us.</p>
          </article>
          <article class="lens-card">
            <span class="lens-number">02</span>
            <div class="lens-art lens-art-library" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <h3>Explore possibilities</h3>
            <p>Search large candidate spaces in computation and update priorities as new feedback arrives.</p>
          </article>
          <article class="lens-card">
            <span class="lens-number">03</span>
            <div class="lens-art lens-art-diagram" aria-hidden="true">
              <svg viewBox="0 0 280 112" focusable="false">
                <rect x="7" y="9" width="266" height="94" rx="12" fill="#e8f2eb" stroke="#a8c5be" />
                <rect x="22" y="24" width="72" height="64" rx="8" fill="#f8fbf5" stroke="#acc9c0" />
                <rect x="32" y="34" width="43" height="7" rx="3.5" fill="#b9d5ca" />
                <rect x="32" y="50" width="52" height="7" rx="3.5" fill="#c4826e" />
                <rect x="32" y="66" width="33" height="7" rx="3.5" fill="#b9d5ca" />
                <path d="M99 56h19M162 56h19" stroke="#668f8a" stroke-width="2" stroke-linecap="round" />
                <path d="m114 52 5 4-5 4m63-8 5 4-5 4" fill="none" stroke="#668f8a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="140" cy="56" r="19" fill="#d0e6db" stroke="#88b3a8" />
                <path d="M130 57c1-6 8-10 14-7m0 0-2-5m2 5-5 1M150 55c0 7-7 11-14 9m0 0 2 5m-2-5 5-1" fill="none" stroke="#386f9c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <rect x="186" y="24" width="72" height="64" rx="8" fill="#f8fbf5" stroke="#acc9c0" />
                <rect x="196" y="34" width="52" height="7" rx="3.5" fill="#c4826e" />
                <rect x="196" y="50" width="40" height="7" rx="3.5" fill="#b9d5ca" />
                <rect x="196" y="66" width="32" height="7" rx="3.5" fill="#b9d5ca" />
              </svg>
            </div>
            <h3>Learn from feedback</h3>
            <p>Compare adaptive search with simpler methods while keeping predictions distinct from biological results.</p>
          </article>
        </div>
        <a class="text-link approach-link" href="/platform">How we’re building the platform <span aria-hidden="true">↗</span></a>
      </div>
    </section>

  </main>
</BaseLayout>
